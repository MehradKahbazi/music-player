// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int        @id @default(autoincrement())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  email     String     @unique
  password  String
  playlists Playlist[]
  firstName String
  lastName  String
  imageUrl  String?
}

model Song {
  id          Int        @id @default(autoincrement())
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  name        String
  artist      Artist     @relation(fields: [artistId], references: [id])
  album       Album      @relation(fields: [albumId], references: [id])
  albumId     Int
  artistId    Int
  playlists   Playlist[]
  url         String?
  filePath    String?
  genre       String?
  year        String?
  duration    Float?
  coverArtUrl String?
}

model Artist {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  songs     Song[]
  name      String   @unique
  imageUrl  String?
  albums    Album[]
}

model Playlist {
  id        Int      @id @default(autoincrement())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  name      String
  songs     Song[]
  user      User     @relation(fields: [userId], references: [id])
  userId    Int
}

model Album {
  id          Int      @id @default(autoincrement())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  songs       Song[]
  artist      Artist   @relation(fields: [artistId], references: [id])
  artistId    Int
  albumArtUrl String?
  year        String?
  genre       String?
}
